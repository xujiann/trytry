# docker compose 环境变量样例（A8）。复制为 .env 并填入**真实强随机值**：
#   cp .env.example .env && edit .env && docker compose up -d
#
# 三个密钥均为必填（docker-compose.yml 用 `:?` 守卫：不设直接报错退出，
# 不给"用仓库里人人可见的默认值跑起生产"的机会——不要在这里放弱默认值）。

# JWT 签名密钥：≥32 位强随机。生成：python -c 'import secrets;print(secrets.token_hex(32))'
MEDPLAT_SECRET=

# 管理员初始口令：≥12 位强口令（生产守卫会拒绝弱口令/默认口令）
MEDPLAT_ADMIN_PASSWORD=

# PostgreSQL 口令。生成：python -c 'import secrets;print(secrets.token_hex(16))'
MEDPLAT_DB_PASSWORD=

# ---- 以下可选，按需取消注释 ----
# 演示种子（虚构数据，仅演示档；生产**不要**开）
# MEDPLAT_SEED_DEMO=1
# uvicorn worker 数（>1 需 Redis 在位；见 server/start.sh）
# MEDPLAT_WORKERS=2
# 多实例/滚动发布：置 0 跳过启动期迁移，由发布流程单独执行（见 docs/发布流程.md）
# MEDPLAT_MIGRATE_ON_START=0
